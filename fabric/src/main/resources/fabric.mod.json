{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"issues": "https://github.com/ThePandaOliver/Pandas-Falling-Trees/issues",
		"sources": "https://github.com/ThePandaOliver/Pandas-Falling-Trees"
	},
	"license": "${mod_license}",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.pandasystems.fallingtrees.fabric.FabricInit"
		],
		"client": [
          "dev.pandasystems.fallingtrees.fabric.client.FabricClientInit"
		]
	},
	"mixins": [
		"fallingtrees.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"fabric-api": "*",
		"minecraft": "${minecraft_version}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/wjPt4vEfXb",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/pandas-falling-trees",
				"modmenu.modrinth": "https://modrinth.com/mod/pandas-falling-trees",
				"modmenu.github_releases": "https://github.com/ThePandaOliver/Pandas-Falling-Trees/releases"
			},
			"update_checker": true
		}
	}
}
